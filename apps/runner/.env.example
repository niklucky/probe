MINIO_SECRET_KEY=signal_password
ENVIRONMENT_VARIABLES_MASTER_KEY=replace-with-the-same-64-hex-key-used-by-the-api

# Browser-assisted authoring resolves deployment connections inside the runner.
# Keep these values identical to the API environment when using env:* connections.
AI_MASTER_KEY=replace-with-the-same-64-hex-key-used-by-the-api
AI_APPROVED_LOCAL_HOSTS=
AI_CONNECTIONS_JSON=[]
